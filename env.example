# Smart Contract Configuration
# Optional: Deployed contract address for REAL SEPOLIA MODE
# If not set, the app automatically uses DEMO MODE with simulated data
NEXT_PUBLIC_CONTRACT_ADDRESS=your_deployed_contract_address_here

# Optional: Pinata JWT for IPFS metadata upload (DO NOT commit actual JWT)
# PINATA_JWT=your_pinata_jwt_here

# Optional: WalletConnect Project ID
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Optional: Sepolia RPC URL (defaults to public RPC if not set)
# For frontend, use NEXT_PUBLIC_SEPOLIA_RPC_URL
# For deployment, use SEPOLIA_RPC_URL
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployment Configuration (for contract deployment only - DO NOT commit)
# PRIVATE_KEY=your_private_key_here
# ETHERSCAN_API_KEY=your_etherscan_api_key_here
